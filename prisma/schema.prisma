// Accounts and profiles for Wukong. Identity and sign-in are handled by Privy;
// this database holds the durable account record and the public profile that
// links a Privy user to their Solana wallet (and thus their on-chain reputation).
// Reputation, scores and payouts stay on-chain; nothing here is a source of truth
// for money.
//
// On Supabase: DATABASE_URL is the transaction pooler (port 6543) used at
// runtime, DIRECT_URL is the session pooler (port 5432) used for schema
// changes. The direct db.<ref>.supabase.co host is IPv6-only, out of reach of
// Vercel builds; scripts/db-sync.mjs falls back to the session pooler. `npm run build` applies this schema and prisma/rls.sql (row
// level security on, no public access) when DIRECT_URL is set. See docs/LAUNCH.md.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id            String         @id // Privy user DID, e.g. "did:privy:..."
  email         String?        @unique
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  profile       Profile?
  notifications Notification[]
}

model Profile {
  id          String    @id @default(cuid())
  userId      String    @unique
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  wallet      String    @unique // Solana pubkey (base58); links to the on-chain Reputation PDA
  handle      String?   @unique // lowercase a-z, 0-9 and _, 3 to 20 characters; set during onboarding
  displayName String
  role        String    @default("worker") // "worker" (does tasks) or "company" (posts tasks); fixed at onboarding
  company     String? // organisation name, for role "company"
  city        String?
  bio         String?
  avatarUrl   String?
  skills      String[]  @default([])
  languages   String[]  @default([])
  emailOnWin  Boolean   @default(true) // email me about results and payouts
  onboardedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([wallet])
}

// One row per (user, event, task): the unique key makes every email idempotent,
// however many times the judge, the keeper or a retry reports the same event.
model Notification {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  kind      String // "judged" | "paid_out" | "shortlist" | "refunded"
  task      String
  payload   Json?
  createdAt DateTime  @default(now())
  readAt    DateTime?
  emailedAt DateTime?

  @@unique([userId, kind, task])
  @@index([userId, createdAt])
}

// Organisations join by invitation (they email help@wukonghq.xyz). A row here lets
// the person who signs in with that email (an email login or Google) finish
// onboarding as this organisation; everyone else onboards as a freelancer.
// Add rows with `npm run company:invite -- <email> "<Organisation>"` or in the
// Supabase table editor (email in lowercase).
model CompanyInvite {
  email     String    @id // lowercase
  company   String
  createdAt DateTime  @default(now())
  claimedBy String?   @unique // the Privy user id that used it
  claimedAt DateTime?
}
