{
  "$schema": "https://opencode.ai/config.json",
  "model": "opencode/space-bunny-free",
  "small_model": "opencode/ling-3.1-flash-free",
  "autoupdate": true,
  "mcp": {
    "tailwindcss": {
      "type": "local",
      "command": ["npx", "-y", "tailwindcss-mcp-server"],
      "enabled": true
    },
    "browser": {
      "type": "local",
      "command": ["npx", "-y", "mcp-browser-agent", "serve"],
      "enabled": true
    },
    "frontend-dev": {
      "type": "local",
      "command": ["uvx", "--from", "frontend-dev-mcp", "--with", "mcp<2", "frontend-mcp"],
      "enabled": true
    }
  }
}