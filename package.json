{
  "name": "wukong",
  "version": "0.1.0",
  "private": true,
  "description": "Post a task. Summon the crowd. Pay the best. Competitive work marketplace on Solana with AI judging and on-chain reputation.",
  "license": "MIT",
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "postinstall": "prisma generate",
    "start": "next start",
    "demo": "tsx scripts/demo.ts",
    "typecheck": "tsc --noEmit",
    "program:build": "anchor build && node scripts/sync-idl.mjs",
    "validator": "bash scripts/validator.sh",
    "setup:localnet": "tsx scripts/setup.ts --cluster localnet",
    "setup:devnet": "tsx scripts/setup.ts --cluster devnet",
    "seed": "tsx scripts/seed.ts",
    "demo:e2e": "tsx scripts/e2e.ts",
    "agent": "tsx scripts/agent-buyer.ts",
    "test": "tsx --test tests/*.test.ts",
    "judge:dryrun": "tsx scripts/judge-dryrun.ts",
    "keeper": "tsx scripts/keeper.ts",
    "ci:chain": "bash scripts/ci-chain.sh",
    "start:prod": "bash scripts/start-prod.sh",
    "export:env": "tsx scripts/export-env.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "0.133.0",
    "@coral-xyz/anchor": "0.32.1",
    "@noble/hashes": "1.8.0",
    "@prisma/client": "^6.19.3",
    "@privy-io/react-auth": "^3.48.1",
    "@privy-io/server-auth": "^1.32.5",
    "@solana/spl-token": "0.4.15",
    "@solana/wallet-adapter-base": "0.9.28",
    "@solana/wallet-adapter-react": "0.15.40",
    "@solana/wallet-adapter-react-ui": "0.9.40",
    "@solana/web3.js": "1.99.0",
    "bs58": "6.0.0",
    "clsx": "2.1.1",
    "lucide-react": "1.55.0",
    "motion": "14.1.0",
    "next": "16.4.0",
    "prisma": "^6.19.3",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "redis": "^6.2.1",
    "resend": "^6.32.1",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.15",
    "typescript": "5.9.3"
  },
  "allowScripts": {
    "prisma@6.19.3": true,
    "@prisma/client@6.19.3": true,
    "@prisma/engines@6.19.3": true
  }
}
